{
  "rewrites": [
    { "source": "/api/extract", "destination": "/api/index" },
    { "source": "/api/invoices", "destination": "/api/index" },
    { "source": "/api/companies", "destination": "/api/index" },
    { "source": "/api/files", "destination": "/api/index" },
    { "source": "/api/account", "destination": "/api/index" },
    { "source": "/api/auth/signup", "destination": "/api/index" },
    { "source": "/api/auth/login", "destination": "/api/index" },
    { "source": "/api/admin/overview", "destination": "/api/index" },
    { "source": "/api/auth/google/start", "destination": "/api/index" },
    { "source": "/api/auth/google/callback", "destination": "/api/index" },
    { "source": "/api/gmail/push", "destination": "/api/index" },
    { "source": "/api/cron/check-mail", "destination": "/api/index" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/login.html", "destination": "/api/index" },
    { "source": "/signup.html", "destination": "/api/index" },
    { "source": "/app.html", "destination": "/api/index" },
    { "source": "/admin.html", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/check-mail", "schedule": "0 5 * * *" }
  ],
  "functions": {
    "api/index.py": { "maxDuration": 60 }
  }
}
